#!/usr/bin/env bash

set -uo pipefail

BREW=/home/linuxbrew/.linuxbrew/bin/brew
UBLUE_TAP_DIR=/home/linuxbrew/.linuxbrew/Homebrew/Library/Taps/ublue-os/homebrew-tap
FACTORY_REF_FILE=/sysroot/ostree/repo/refs/heads/kuubik/factory

usage() {
	cat <<'EOF'
kctl - system management

Usage:
  kctl upgrade                 Pull and apply the latest system image, then
                                update flatpaks and homebrew
  kctl rollback                Pick a system image to boot from now on
  kctl overrides               List local changes on top of the system image:
                                packages, /etc files, unlocked /usr, initramfs
  kctl disable-update-notify   Turn off the "system is out of date" notification
  kctl enroll-secure-boot-key  Queue the kuubik secure boot key for enrollment
  kctl help                    Show this help
EOF
}

cmd_upgrade() {
	local reply
	read -r -p "Update system, flatpak, and brew now? [Y/n] " reply || reply=""
	case "$reply" in
	[Nn]*)
		echo "Aborted."
		return 0
		;;
	esac

	echo "==> Checking for a new system image..."
	if ! rpm-ostree upgrade; then
		echo "kctl: system image update failed, skipping flatpak/brew" >&2
		return 1
	fi

	echo "==> Updating flatpaks..."
	flatpak update -y || echo "kctl: flatpak update failed" >&2

	if [ -x "$BREW" ]; then
		echo "==> Updating homebrew..."
		"$BREW" update && "$BREW" upgrade || echo "kctl: brew update failed" >&2
	fi

	echo "Done. Reboot to apply any staged system update."
}

cmd_rollback() {
	local status_json factory_version reply i n id version note
	local -a ids versions notes
	status_json="$(rpm-ostree status --json)" || return 1

	# non-staged deployments are the boot menu entries, the first one boots by default
	while IFS=$'\t' read -r id version note; do
		ids+=("$id")
		versions+=("$version")
		notes+=("$note")
	done < <(jq -r '.deployments[] | select(.staged | not) |
		[.id, (.version // .checksum[0:12]), (if .booted then "running now" else "" end)] | @tsv' <<<"$status_json")

	factory_version=""
	if [ -e "$FACTORY_REF_FILE" ]; then
		factory_version="$(ostree show --repo=/sysroot/ostree/repo --print-metadata-key=version kuubik/factory 2>/dev/null | tr -d "'")"
		factory_version="${factory_version:-unknown version}"
	fi

	echo "Images in the boot menu:"
	for i in "${!ids[@]}"; do
		printf '  %d) %s  %s\n' "$((i + 1))" "${versions[$i]}" "${notes[$i]}"
	done
	n=${#ids[@]}
	if [ -n "$factory_version" ]; then
		echo
		echo "Factory image:"
		printf '  %d) %s\n' "$((n + 1))" "$factory_version"
		echo "     The image this computer was installed with. Updates replace the images in the"
		echo "     boot menu, so this one is kept aside: it is not in the boot menu and never"
		echo "     cleaned up, so there is always a known-good system to go back to."
	fi
	echo

	read -r -p "Pick an image [q to quit]: " reply || reply=q
	if [ -n "$factory_version" ] && [ "$reply" = "$((n + 1))" ]; then
		echo "Rolling back to the factory image is not available yet, see"
		echo "https://github.com/kuubik-os/kuubik/issues/54"
		return 1
	fi
	if ! [[ "$reply" =~ ^[0-9]+$ ]] || [ "$reply" -lt 1 ] || [ "$reply" -gt "$n" ]; then
		echo "Aborted."
		return 0
	fi
	id="${ids[$((reply - 1))]}"
	version="${versions[$((reply - 1))]}"

	if [ "$id" = "$(jq -r '.deployments[0].id' <<<"$status_json")" ]; then
		echo "$version already boots by default."
		return 0
	fi

	read -r -p "Boot $version from now on? [y/N] " reply || reply=""
	case "$reply" in
	[Yy]*) ;;
	*)
		echo "Aborted."
		return 0
		;;
	esac

	# a staged update is finalized on shutdown and would boot next anyway
	if jq -e '.deployments[0].staged' <<<"$status_json" >/dev/null; then
		echo "==> Discarding the pending update..."
		sudo rpm-ostree cleanup -p || return 1
	fi

	i="$(rpm-ostree status --json | jq --arg id "$id" '.deployments | map(.id) | index($id)')"
	sudo ostree admin set-default "$i" || return 1
	echo "Done. Reboot to start $version."
}

cmd_overrides() {
	local status_json etc_diff kind item
	local -a lines=()
	status_json="$(rpm-ostree status --json --booted)" || return 1
	# /etc is compared to the image's default copy in /usr/etc, needs root
	etc_diff="$(sudo ostree admin config-diff)" || return 1

	while IFS=$'\t' read -r kind item; do
		lines+=("$(printf '  %-10s %s' "$kind" "$item")")
	done < <(jq -r '.deployments[0] |
		(.["requested-packages"][]?, .["requested-local-packages"][]? | ["layered", .]),
		(.["requested-base-removals"][]? | ["removed", .]),
		(.["requested-base-local-replacements"][]?, (.["base-remote-replacements"] // {} | .[][]?) | ["replaced", .]),
		(.["requested-local-fileoverride-packages"][]? | ["overrides", .]),
		(select((.unlocked // "none") != "none") | ["unlocked", "/usr (\(.unlocked))"]),
		(select(.["regenerate-initramfs"]) | ["initramfs", "regenerated locally \(.["initramfs-args"] // [] | join(" "))"]),
		(.["initramfs-etc"][]? | ["initramfs", "includes \(.)"]) | @tsv' <<<"$status_json")

	while read -r kind item; do
		# differ on every install: written by the installer, first boot or account and network setup
		case "$item" in
		passwd | passwd- | group | group- | shadow | shadow- | gshadow | gshadow- | \
			subuid | subuid- | subgid | subgid- | .pwd.lock | machine-id | hostname | \
			localtime | adjtime | locale.conf | vconsole.conf | fstab | crypttab | resolv.conf | \
			.updated | default/useradd | X11/xorg.conf.d/00-keyboard.conf | ssh/ssh_host_* | \
			NetworkManager/system-connections/* | lvm/devices/* | lvm/archive* | lvm/backup*)
			continue
			;;
		esac
		case "$kind" in
		M) kind=modified ;;
		A) kind=added ;;
		D) kind=deleted ;;
		*) continue ;;
		esac
		lines+=("$(printf '  %-10s /etc/%s' "$kind" "$item")")
	done <<<"$etc_diff"

	if [ ${#lines[@]} -eq 0 ]; then
		echo "No local changes on top of the system image."
		return 0
	fi
	echo "Local changes on top of $(jq -r '.deployments[0] | .version // .checksum[0:12]' <<<"$status_json"):"
	printf '%s\n' "${lines[@]}"
}

cmd_disable_update_notify() {
	systemctl --user mask --now kctl-update-notify.timer
	echo "Update notifications disabled. Re-enable with:"
	echo "  systemctl --user unmask kctl-update-notify.timer"
}

cmd_enroll_secure_boot_key() {
	echo "Choose a one-time password. On the next boot pick \"Enroll MOK\" in the blue"
	echo "MokManager screen and enter it, then secure boot can be enabled."
	sudo mokutil --import /usr/share/kuubik/secureboot/kuubik.der
}

# tapped here, not at first boot, which may be offline. brew refuses to run as root
if [ -x "$BREW" ] && [ ! -d "$UBLUE_TAP_DIR" ] && [ "$EUID" -ne 0 ]; then
	echo "==> Adding the ublue-os homebrew tap..." >&2
	# brew 6+ won't load non-official taps by short name until trusted
	{ "$BREW" tap ublue-os/tap && "$BREW" trust ublue-os/tap; } >&2 || echo "kctl: brew tap failed, retrying on next run" >&2
fi

case "${1:-help}" in
upgrade) cmd_upgrade ;;
rollback) cmd_rollback ;;
overrides) cmd_overrides ;;
disable-update-notify) cmd_disable_update_notify ;;
enroll-secure-boot-key) cmd_enroll_secure_boot_key ;;
help | --help | -h) usage ;;
*)
	echo "kctl: unknown command '${1:-}'" >&2
	usage >&2
	exit 1
	;;
esac
