{
    "default": [
        {
            "type": "insecureAcceptAnything"
        }
    ],
    "transports": {
        "docker": {
            "ghcr.io/kuubik-os/kuubik": [
                {
                    "type": "sigstoreSigned",
                    "keyPath": "/etc/pki/containers/kuubik.pub",
                    "signedIdentity": {
                        "type": "matchRepository"
                    }
                }
            ],
            "ghcr.io/kuubik-os/kuubik-nvidia": [
                {
                    "type": "sigstoreSigned",
                    "keyPath": "/etc/pki/containers/kuubik.pub",
                    "signedIdentity": {
                        "type": "matchRepository"
                    }
                }
            ],
            "ghcr.io/kuubik-os/kuubik-lts": [
                {
                    "type": "sigstoreSigned",
                    "keyPath": "/etc/pki/containers/kuubik.pub",
                    "signedIdentity": {
                        "type": "matchRepository"
                    }
                }
            ],
            "ghcr.io/kuubik-os/kuubik-lts-nvidia": [
                {
                    "type": "sigstoreSigned",
                    "keyPath": "/etc/pki/containers/kuubik.pub",
                    "signedIdentity": {
                        "type": "matchRepository"
                    }
                }
            ]
        },
        "docker-daemon": {
            "": [
                {
                    "type": "insecureAcceptAnything"
                }
            ]
        }
    }
}
