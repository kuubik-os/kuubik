#!/usr/bin/env bash

# check if currently running OS version is > 1 month older of upstream
# 1) local version checked by rpm-ostree status
# 2) upstream checked by skopeo inspect

set -uo pipefail

VERSION_RE='^([0-9]{8})\.[0-9]+$'

status_json="$(rpm-ostree status --json)" || exit 0

current_version="$(jq -r '.deployments[] | select(.booted) | .version // empty' <<<"$status_json")"
image_ref="$(jq -r '.deployments[] | select(.booted) | .["container-image-reference"] // empty' <<<"$status_json")"
[ -n "$current_version" ] && [ -n "$image_ref" ] || exit 0

[[ "$current_version" =~ $VERSION_RE ]] || exit 0
current_date="${BASH_REMATCH[1]}"

pullspec="ghcr.io/${image_ref#*ghcr.io/}"
[ "$pullspec" != "ghcr.io/$image_ref" ] || exit 0

latest_version="$(skopeo inspect --no-tags "docker://${pullspec}" 2>/dev/null |
	jq -r '.Labels["org.opencontainers.image.version"] // empty')"
[ -n "$latest_version" ] || exit 0

[[ "$latest_version" =~ $VERSION_RE ]] || exit 0
latest_date="${BASH_REMATCH[1]}"

# utc, so a dst change between the two dates can't drop a day
current_epoch="$(date -u -d "$current_date" +%s)" || exit 0
latest_epoch="$(date -u -d "$latest_date" +%s)" || exit 0
age_days=$(((latest_epoch - current_epoch) / 86400))

[ "$age_days" -ge 30 ] || exit 0

action="$(timeout 6h notify-send \
	--app-name="kctl" \
	--icon=system-software-update \
	--action=update="Update now" \
	--wait \
	"System update available" \
	"This system is running a build from ${current_date}, more than a month behind the latest available update.")"

if [ "$action" = "update" ]; then
	konsole -e kctl upgrade &
fi
